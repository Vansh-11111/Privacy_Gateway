# Copy to .env for local use. NEVER commit .env (it is in .gitignore).
# For a website host (Render etc.) put these in the host's "Environment" settings instead.

# demo = the public dashboard with the scripted bot (needs nothing else)
# production = the real gateway API in front of a real model (needs everything below)
PII_MODE=demo

# ---- production only. Create the first four with:  python -m gateway.config keys
PII_ADMIN_KEY=
PII_VAULT_KEY=
PII_AUDIT_SALT=
PII_API_KEYS=

# Any OpenAI-compatible endpoint. Examples:
#   https://api.openai.com/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
#   https://api.groq.com/openai/v1
#   http://localhost:11434/v1        (Ollama on your own machine)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 1 when behind a host's load balancer (Render, Railway, ...)
PII_TRUST_PROXY=0
PII_RATE_LIMIT_PER_MIN=60
PII_AUDIT_DB=audit.db
